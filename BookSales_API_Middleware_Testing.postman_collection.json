		{
			"name": "4. Pertemuan 7 - Transaksi (CRUD)",
			"item": [
				{
					"name": "Customer - Create Transaction",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.id) {",
									"    pm.collectionVariables.set(\"transaction_id\", jsonData.data.id);",
